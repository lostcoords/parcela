#!/bin/sh
# Installs the tools the checks need into ~/.local/bin on a CI runner: jj for discovery tests,
# Caddy for the live suites. Versions match docs/install.sh.
set -eu
JJ_VERSION=0.40.0
CADDY_VERSION=2.11.7
BIN="$HOME/.local/bin"
mkdir -p "$BIN"
case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) jj=x86_64-unknown-linux-musl caddy=linux_amd64 ;;
  Linux-aarch64) jj=aarch64-unknown-linux-musl caddy=linux_arm64 ;;
  Darwin-arm64) jj=aarch64-apple-darwin caddy=mac_arm64 ;;
  Darwin-x86_64) jj=x86_64-apple-darwin caddy=mac_amd64 ;;
  *) echo "unsupported runner $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
get() {
  curl --proto '=https' --tlsv1.2 -fsSL "$1" | tar -xz -C "$BIN" "$2"
}
get "https://github.com/jj-vcs/jj/releases/download/v$JJ_VERSION/jj-v$JJ_VERSION-$jj.tar.gz" ./jj
get "https://github.com/caddyserver/caddy/releases/download/v$CADDY_VERSION/caddy_${CADDY_VERSION}_$caddy.tar.gz" caddy
if [ -n "${GITHUB_PATH:-}" ]; then
  echo "$BIN" >> "$GITHUB_PATH"
fi
"$BIN/jj" --version
"$BIN/caddy" version
