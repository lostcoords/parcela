#!/usr/bin/env python3
"""Points the Homebrew formula at a published release: scripts/update-tap v0.9.1 path/to/parcela.rb

Takes each archive's checksum from the release's .sha256 files and replaces every
download URL and the sha256 under it. Fails, changing nothing, unless every target is there.
"""
import re
import sys
import urllib.request

RELEASES = 'https://github.com/lostcoords/parcela/releases/download'
TARGETS = ['aarch64-apple-darwin', 'x86_64-apple-darwin', 'aarch64-unknown-linux-gnu', 'x86_64-unknown-linux-gnu']


def main(tag, formula):
    if not re.fullmatch(r'v\d+\.\d+\.\d+', tag):
        sys.exit(f'not a release tag: {tag}')
    text = original = open(formula).read()
    for target in TARGETS:
        url = f'{RELEASES}/{tag}/parcela-{target}.tar.gz'
        with urllib.request.urlopen(f'{url}.sha256', timeout=30) as response:
            sha = response.read().decode().split()[0]
        if not re.fullmatch(r'[0-9a-f]{64}', sha):
            sys.exit(f'bad checksum for {target}: {sha!r}')
        pattern = re.compile(rf'url "{re.escape(RELEASES)}/v[^/"]+/parcela-{re.escape(target)}\.tar\.gz"(\s+)sha256 "[0-9a-f]+"')
        text, count = pattern.subn(f'url "{url}"\\1sha256 "{sha}"', text)
        if count != 1:
            sys.exit(f'{formula}: expected one url and sha256 for {target}, found {count}')
    if text != original:
        open(formula, 'w').write(text)
    print(f'{formula}: {"updated to" if text != original else "already at"} {tag}')


if __name__ == '__main__':
    if len(sys.argv) != 3:
        sys.exit(__doc__.splitlines()[0])
    main(*sys.argv[1:])
