    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "github-slugger": "2.0.0",
    "reka-ui": "2.11.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "vitepress": "1.6.4",
