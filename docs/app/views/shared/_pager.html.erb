<% listed = Docs::GROUPS.flat_map(&:pages) %>
<% index = listed.index(@page) %>
<% if index %>
  <% previous, following = (listed[index - 1] if index > 0), listed[index + 1] %>
  <nav class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2" aria-label="Pages">
    <% if previous %>
      <a href="<%= previous.path %>" class="rounded-2xl border border-border p-4 no-underline hover:bg-muted"><span class="block text-xs text-muted-foreground">Previous</span><span class="font-semibold text-foreground"><%= previous.title %></span></a>
    <% else %><span></span><% end %>
    <% if following %>
      <a href="<%= following.path %>" class="rounded-2xl border border-border p-4 text-end no-underline hover:bg-muted"><span class="block text-xs text-muted-foreground">Next</span><span class="font-semibold text-foreground"><%= following.title %></span></a>
    <% end %>
  </nav>
<% end %>
