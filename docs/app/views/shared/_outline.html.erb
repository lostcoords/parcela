<% outline = Docs.outline(@html) %>
<% if outline.size > 1 %>
  <nav class="page-outline text-sm" aria-labelledby="outline-title">
    <p id="outline-title" class="mb-3 text-xs font-semibold text-foreground">On this page</p>
    <ul class="space-y-2">
      <% outline.each do |level, id, text| %>
        <li class="<%= "ps-3" if level == 3 %>"><a href="#<%= id %>" class="block text-muted-foreground no-underline hover:text-foreground"><%= text %></a></li>
      <% end %>
    </ul>
  </nav>
<% end %>
