<section class="cta" aria-labelledby="install">
  <div class="cta-inner">
    <div class="pitch">
      <%= image_tag "logo.png", alt: "", width: 120, height: 120, class: "mascot" %>
      <div>
        <%= section_heading("install") { "Install Parcela" } %>
        <p class="cta-lead">Install the CLI, then run <code class="inline-code">parcela init</code> in your project.</p>
        <p class="project-note">Experimental · macOS &amp; Linux · AGPL-3.0-only</p>
      </div>
    </div>
    <div class="cta-try">
      <%= install_command class: "cta-install" %>
      <div class="cta-actions">
        <%= home_button "Get started", "/docs/getting-started/", start: true, data: { umami_event: "get-started", umami_event_place: "cta" } %>
        <%= home_button "Read the docs", "/docs/", variant: :secondary, arrow: false %>
      </div>
    </div>
  </div>
</section>
